+++ b/core/src/main/kotlin/app/toque/core/recipes/PersonalCatalog.kt
@@ -0,0 +1,60 @@
+package app.toque.core.recipes
+
+import app.toque.core.i18n.tr
+import app.toque.core.json.Json
+import app.toque.core.json.obj
+
+/** Catalogue personnel indépendant du catalogue Lidl, sans commande d'exécution distante. */
+object PersonalCatalog {
+    const val REPOSITORY = "maximehuran/monsieur-cuisine-recipes"
+    const val URL = "https://api.github.com/repos/$REPOSITORY/contents/catalog.json"
+    const val PREFIX = "perso-"
+    private val idPattern = Regex("perso-[a-z0-9][a-z0-9-]{0,95}")
+
+    fun isPersonal(id: String): Boolean = id.startsWith(PREFIX)
+    fun keepDuringLidl(id: String, keep: Set<String>): Boolean = isPersonal(id) || id in keep
+
+    private fun check(condition: Boolean) {
+        require(condition) { tr("Catalogue GitHub invalide : aucune recette n’a été modifiée.") }
+    }
+
+    private fun integer(value: Any?, range: IntRange): Boolean {
+        val n = value as? Number ?: return false
+        val d = n.toDouble()
+        return d.isFinite() && d == n.toInt().toDouble() && n.toInt() in range
+    }
+
+    /** Refuse tout le catalogue si une entrée est invalide ; aucune importation partielle. */
+    fun parse(text: String): List<Recipe> {
+        val root = Json.parse(text).obj()
+        check(root["format"] == RecipeCodec.FORMAT)
+        val entries = root["recipes"] as? List<*> ?: throw IllegalArgumentException(tr("Catalogue GitHub invalide : aucune recette n’a été modifiée."))
+        check(entries.size <= 500)
+        val seen = HashSet<String>()
+        return entries.map { entry ->
+            check(entry is Map<*, *>)
+            val m = entry.obj()
+            val id = m["id"] as? String ?: ""
+            check(idPattern.matches(id) && seen.add(id) && m["source"] == "user")
+            val steps = m["steps"] as? List<*> ?: emptyList<Any?>()
+            check(steps.isNotEmpty() && steps.size <= 500)
+            for (step in steps) {
+                val s = step.obj()
+                check((s["text"] as? String)?.isNotBlank() == true)
+                s["weigh"]?.let { weigh -> check(weigh is Map<*, *> && integer(weigh.obj()["grams"], 1..5000)) }
+                s["machine"]?.let { machine ->
+                    check(machine is Map<*, *>)
+                    val mc = machine.obj()
+                    check(StepProgram.of(mc["program"] as? String) != null)
+                    check(integer(mc["seconds"], 1..5940) && integer(mc["speed"], 0..10) && integer(mc["tempC"], 0..130))
+                    check(mc["reverse"] == null || mc["reverse"] is Boolean)
+                    check(mc["accessory"] == null || mc["accessory"] in listOf("blade", "whisk"))
+                }
+            }
+            val r = RecipeCodec.fromMap(m, RecipeSource.USER)
+            check(r != null && r.steps.size == steps.size && r.steps.all { it.machine?.valid != false })
+            r!!.copy(source = RecipeSource.USER, favorite = false,
+                steps = r.steps.map { it.copy(needsReview = it.machine != null || it.needsReview) })
+        }
+    }
+}
