@@ -0,0 +1,54 @@
+package app.toque.core
+
+import app.toque.core.recipes.PersonalCatalog
+import app.toque.core.recipes.RecipeSource
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.Assume.assumeNotNull
+import java.io.File
+
+class PersonalCatalogTest {
+    private val recipe = """{"id":"perso-test","title":"Essai","source":"user","steps":[{"text":"Vérifier avant de lancer","machine":{"program":"manuel","seconds":30,"speed":5,"tempC":0,"reverse":false,"accessory":"blade"}}]}"""
+    private fun catalog(vararg recipes: String) = """{"format":"toque-recettes-1","recipes":[${recipes.joinToString(",")}]}"""
+    private fun refused(text: String) {
+        try { PersonalCatalog.parse(text); fail("Le catalogue devait être refusé") } catch (_: IllegalArgumentException) { }
+    }
+
+    @Test fun personalRecipeKeepsGuidedSettingsAndAlwaysRequiresReview() {
+        val r = PersonalCatalog.parse(catalog(recipe)).single()
+        assertEquals(RecipeSource.USER, r.source)
+        assertEquals(30, r.steps.single().machine!!.seconds)
+        assertTrue(r.steps.single().needsReview)
+    }
+    @Test fun importedIdsAndDuplicateIdsAreRejected() {
+        refused(catalog(recipe.replace("perso-test", "web-123")))
+        refused(catalog(recipe, recipe))
+    }
+    @Test fun unsafeOrSilentlyDroppedMachineSettingsAreRejected() {
+        refused(catalog(recipe.replace("\"speed\":5", "\"speed\":11")))
+        refused(catalog(recipe.replace("\"tempC\":0", "\"tempC\":80")))
+        refused(catalog(recipe.replace("\"program\":\"manuel\"", "\"program\":\"inconnu\"")))
+        refused(catalog(recipe.replace("\"seconds\":30", "\"seconds\":-30")))
+        refused(catalog(recipe.replace("\"seconds\":30", "\"seconds\":1.5")))
+    }
+    @Test fun badCatalogNeverBecomesAnEmptySuccessfulImport() {
+        refused("{}")
+        refused("""{"format":"toque-recettes-1","recipes":null}""")
+        refused(catalog(recipe, "{}"))
+        assertTrue(PersonalCatalog.parse(catalog()).isEmpty())
+    }
+    @Test fun lidlReconciliationPreservesPersonalRecipes() {
+        assertTrue(PersonalCatalog.keepDuringLidl("perso-test", emptySet()))
+        assertTrue(PersonalCatalog.keepDuringLidl("web-123", setOf("web-123")))
+        assertFalse(PersonalCatalog.keepDuringLidl("web-456", setOf("web-123")))
+    }
+    @Test fun publishedCatalogContainsAnExecutableReviewedTestRecipe() {
+        val path = System.getenv("PERSONAL_CATALOG_PATH")
+        assumeNotNull(path)
+        val recipes = PersonalCatalog.parse(File(path!!).readText())
+        assertTrue(recipes.isNotEmpty())
+        val clean = recipes.first { it.id == "perso-nettoyage-doux-du-bol" }
+        assertTrue(clean.steps.any { it.machine != null })
+        assertTrue(clean.steps.all { it.machine == null || it.needsReview && it.machine!!.valid })
+    }
+}
