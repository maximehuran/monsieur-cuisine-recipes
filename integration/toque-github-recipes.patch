@@ -0,0 +1,97 @@
+package app.toque.recipes
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import app.toque.Http
+import app.toque.ToqueApp
+import app.toque.core.i18n.tr
+import app.toque.core.recipes.PersonalCatalog
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Un catalogue de données : ce composant n'envoie aucune commande au moteur. */
+object PersonalSync {
+    private val main = Handler(Looper.getMainLooper())
+    private val running = AtomicBoolean(false)
+    private var started = false
+    private var startupPending = true
+    private var lastAttempt = -900_000L
+
+    private fun idle(app: ToqueApp): Boolean = app.machine.connected &&
+        !app.machine.snapshot.busy && app.prefs.guidedRecipe.isBlank()
+
+    /** Appel et résultat sur le fil de l'interface ; téléchargement et analyse hors de ce fil. */
+    fun sync(app: ToqueApp, done: (Boolean, String) -> Unit = { _, _ -> }) {
+        check(Looper.myLooper() == Looper.getMainLooper())
+        if (!idle(app)) {
+            done(false, tr("Synchronisation différée : attendez que le robot soit au repos et la recette terminée."))
+            return
+        }
+        if (!running.compareAndSet(false, true)) {
+            done(false, tr("Synchronisation déjà en cours"))
+            return
+        }
+        Thread {
+            try {
+                val text = Http.get(PersonalCatalog.URL,
+                    mapOf("Accept" to "application/vnd.github.raw+json"),
+                    timeoutMs = 20_000, maxBytes = 2 * 1024 * 1024).body
+                val recipes = PersonalCatalog.parse(text)
+                main.post {
+                    try {
+                        if (!idle(app)) {
+                            done(false, tr("Synchronisation différée : attendez que le robot soit au repos et la recette terminée."))
+                        } else {
+                            app.recipes.replacePersonal(recipes)
+                            app.prefs.personalLastSyncMs = System.currentTimeMillis()
+                            val message = tr("%d recettes personnelles à jour", recipes.size)
+                            app.prefs.personalSyncResult = message
+                            app.log.write("github", message)
+                            startupPending = false
+                            done(true, message)
+                        }
+                    } catch (e: Exception) {
+                        reportError(app, e, done)
+                    } finally { running.set(false) }
+                }
+            } catch (e: Exception) {
+                main.post {
+                    try { reportError(app, e, done) } finally { running.set(false) }
+                }
+            }
+        }.start()
+    }
+
+    private fun reportError(app: ToqueApp, error: Exception, done: (Boolean, String) -> Unit) {
+        val message = tr("Synchronisation GitHub impossible : %s", error.message ?: error.toString())
+        app.prefs.personalSyncResult = message
+        app.log.crash("github", error)
+        done(false, message)
+    }
+
+    /** Au démarrage, puis chaque jour pendant que Toque est ouvert ; reprise si le Wi-Fi arrive tard. */
+    @Suppress("DEPRECATION")
+    fun start(app: ToqueApp) {
+        if (started) return
+        started = true
+        val tick = object : Runnable {
+            override fun run() {
+                try {
+                    val now = System.currentTimeMillis()
+                    val elapsed = SystemClock.elapsedRealtime()
+                    val network = app.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
+                    val due = startupPending || now - app.prefs.personalLastSyncMs >= 86_400_000L
+                    if (app.prefs.personalAutoSync && due && now >= 1_735_689_600_000L &&
+                        network.activeNetworkInfo?.isConnected == true && idle(app) &&
+                        !running.get() && elapsed - lastAttempt >= 900_000L) {
+                        lastAttempt = elapsed
+                        sync(app)
+                    }
+                } finally { main.postDelayed(this, 60_000L) }
+            }
+        }
+        main.postDelayed(tick, 30_000L)
+    }
+}
