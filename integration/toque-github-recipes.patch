+    /** Remplace uniquement le catalogue personnel en transaction ; les favoris sont séparés. */
+    fun replacePersonal(recipes: List<Recipe>) {
+        require(recipes.all { PersonalCatalog.isPersonal(it.id) })
+        exec.submit {
+            val db = helper.writableDatabase
+            db.beginTransaction()
+            try {
+                val keep = recipes.map { it.id }.toHashSet()
+                val gone = ArrayList<String>()
+                db.rawQuery("SELECT id FROM recipes WHERE id LIKE ?", arrayOf("${PersonalCatalog.PREFIX}%")).use { c ->
+                    while (c.moveToNext()) c.getString(0).let { if (it !in keep) gone += it }
+                }
+                for (id in gone) db.delete("recipes", "id = ?", arrayOf(id))
+                val now = System.currentTimeMillis()
+                for (r in recipes) {
+                    val values = ContentValues()
+                    values.put("id", r.id)
+                    values.put("title", r.title)
+                    values.put("json", RecipeCodec.encode(r.copy(favorite = false)))
+                    values.put("updated", now)
+                    check(db.insertWithOnConflict("recipes", null, values, SQLiteDatabase.CONFLICT_REPLACE) != -1L)
+                }
+                db.setTransactionSuccessful()
+            } finally { db.endTransaction() }
+            rebuild()
+        }.get()
+    }
+
     /** Recharge l'index de recherche (après des mises à jour sans [rebuild]). */
     fun refresh() {
         exec.submit { rebuild() }.get()
